# ── CLōD (LLM gateway, OpenAI-compatible) ─────────────────
CLOD_API_KEY=your-clod-api-key-here
CLOD_BASE_URL=https://api.clod.io/v1
CLOD_ACTIVE_MODEL=anthropic/claude-opus-4
CLOD_SUMMARY_MODEL=meta-llama/llama-3.1-8b-instruct
CLOD_MAX_OUTPUT_TOKENS=8096

# ── Context window management ─────────────────────────────
CONTEXT_TRANSFER_THRESHOLD=0.80
CONTEXT_LIMIT_TOKENS=200000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/agent_system

# ── MCP server ────────────────────────────────────────────
MCP_TRANSPORT=stdio          # 'stdio' | 'sse'
SSE_HOST=0.0.0.0
SSE_PORT=3001
LOG_LEVEL=info

# ── Greptile (codebase search) ────────────────────────────
GREPTILE_API_KEY=grpt-...
GREPTILE_GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GREPTILE_BASE_URL=https://api.greptile.com/v2

# ── AllScale Checkout (stablecoin billing) ────────────────
# Public + secret pair from app.allscale.io > Settings > Commerce.
# All requests are signed with HMAC-SHA256 over a canonical string:
#   METHOD\nPATH\nQUERY\nTIMESTAMP\nNONCE\nBODY_SHA256
ALLSCALE_API_KEY=st_your_allscale_public_key_here
ALLSCALE_API_SECRET=st_your_allscale_secret_key_here
ALLSCALE_BASE_URL=https://openapi.allscale.io
# AllScale stablecoin enum (1 = USDT). USDT is the only supported coin today.
ALLSCALE_STABLECOIN=1
# Pricing rate. Minimum settlement is 0.1 USDT.
ALLSCALE_USD_PER_1K_TOKENS=0.02
# Optional redirect after the user completes payment.
ALLSCALE_REDIRECT_URL=
